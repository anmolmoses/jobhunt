# Lab runs in Next.js dev mode inside the container.
# The lab imports from ../src, so the entire repo is the build context.
# Source dirs are bind-mounted in docker-compose.yml so edits on host are live.

FROM node:20-slim

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN npm install -g @anthropic-ai/claude-code
# Root package — lab's @/ alias resolves to ../src which imports some root deps
COPY package.json package-lock.json* ./
RUN npm ci

# Lab package
COPY lab/package.json lab/package-lock.json* ./lab/
RUN cd lab && npm ci

# Copy the rest (will be overlaid by bind mounts from compose for live dev)
COPY . .

ENV NODE_ENV=development
ENV HOSTNAME=0.0.0.0
ENV PORT=3100

EXPOSE 3100

CMD ["npm", "run", "dev", "--prefix", "lab"]
